<button
  class="action"
  id="open-cv-download"
  type="button"
  aria-haspopup="dialog"
  aria-controls="cv-download"
>
  Descargar CV
</button>

<dialog
  id="cv-download"
  aria-labelledby="cv-download-title"
  class="fixed inset-0 m-auto max-h-[calc(100%_-_2rem)] w-[calc(100%_-_2rem)] max-w-md overflow-auto rounded-3xl border border-line bg-white p-6 text-ink shadow-xl backdrop:bg-ink/45 sm:p-8"
>
  <div class="flex flex-wrap items-center justify-between gap-3">
    <h2 id="cv-download-title" class="text-xl font-semibold">Descargar CV</h2>
    <form method="dialog">
      <button class="action" type="submit">Cerrar</button>
    </form>
  </div>
  <p class="mt-3 text-sm text-muted">Elige el idioma de tu descarga.</p>

  <div class="mt-5 grid gap-3">
    <a class="action justify-start" href="/cv/CV-Jesus-Chacon-ES.pdf" download autofocus>Español</a>
    <a class="action justify-start" href="/cv/CV-Jesus-Chacon-EN.pdf" download>Inglés</a>
  </div>
</dialog>

<script>
  const openButton = document.querySelector<HTMLButtonElement>('#open-cv-download');
  const dialog = document.querySelector<HTMLDialogElement>('#cv-download');

  if (openButton && dialog) {
    openButton.addEventListener('click', () => dialog.showModal());
    dialog.addEventListener('close', () => openButton.focus());
  }
</script>
