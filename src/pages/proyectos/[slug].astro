---
import type { GetStaticPaths } from 'astro';
import { projects, type Project } from '../../data/portfolio';
import SiteLayout from '../../layouts/SiteLayout.astro';

export const getStaticPaths = (() => projects.map((project) => ({
  params: { slug: project.slug },
  props: { project },
}))) satisfies GetStaticPaths;

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { name, description, role, period, label, stack, caseStudy } = project;
const {
  tagline,
  visibilityNote,
  challenge,
  approach,
  concept,
  productHeading,
  features,
  orderedFeatures,
  clinicalManagement,
  integrations,
  contribution,
  nextSteps,
  stackNote,
} = caseStudy;
const ProductList = orderedFeatures ? 'ol' : 'ul';
const supportingSections = [
  { id: 'clinical-management-heading', title: 'Gestión clínica y documental', cards: clinicalManagement, columns: 'md:grid-cols-2' },
  { id: 'integrations-heading', title: 'Integraciones', cards: integrations, columns: 'md:grid-cols-2 lg:grid-cols-3' },
];
---

<SiteLayout title={`${name} · Porfolio de Jesús Chacón Ávila`} description={description}>
  <header class="sticky top-0 z-10 border-b border-line bg-white/95 backdrop-blur-sm">
    <nav class="page-container flex min-h-16 items-center justify-between gap-4 py-3" aria-label="Navegación del proyecto">
      <a href="/" class="font-heading text-lg font-bold" aria-label="Jesús Chacón Ávila, inicio">JC<span class="text-teal-ink">.</span></a>
      <a href="/#proyectos" class="text-sm font-semibold text-muted underline-offset-4 hover:text-teal-ink hover:underline">
        <span class="mr-1" aria-hidden="true">←</span> Volver al porfolio
      </a>
    </nav>
  </header>

  <main id="contenido" class="scroll-mt-20" tabindex="-1">
    <section class="page-container pt-16 pb-14 md:pt-24 md:pb-20" aria-labelledby="project-heading">
      <div class="max-w-2xl">
        {label && <p class="inline-flex rounded-full bg-apricot-pale px-3 py-1 text-sm font-semibold">{label}</p>}
        <h1 id="project-heading" class:list={['text-4xl leading-tight font-bold tracking-tight sm:text-5xl lg:text-6xl', label && 'mt-6']}>{name}</h1>
        {role && <p class="mt-4 text-sm font-bold text-teal-ink">{role}{period && <span class="font-semibold text-muted"> · {period}</span>}</p>}
        <p class="mt-6 text-2xl leading-snug font-bold md:text-3xl">{tagline}</p>
        <p class="mt-5 text-lg leading-relaxed text-muted">{description}</p>
        {visibilityNote && <p class="mt-4 text-sm leading-relaxed text-muted">{visibilityNote}</p>}
        <a href="#proyecto" class="action action-primary mt-8">
          Leer el caso de estudio <span class="ml-2" aria-hidden="true">→</span>
        </a>
      </div>

      <div class="mt-9 flex items-center gap-3 border-t border-line pt-6">
        <img src="/images/jesus-chacon.png" alt="" width="48" height="48" class="size-12 rounded-full object-cover" />
        <div>
          <p class="text-sm font-bold">Jesús Chacón Ávila</p>
          <p class="text-xs text-muted">Tech Lead / Full Stack Developer · Málaga</p>
        </div>
      </div>
    </section>

    <section id="proyecto" class="scroll-mt-16 bg-mist py-16 md:py-24" aria-labelledby="challenge-heading">
      <div class:list={['page-container', concept && 'grid items-center gap-9 md:grid-cols-2 md:gap-14']}>
        <div class="max-w-prose">
          <h2 id="challenge-heading" class="section-heading">El reto</h2>
          <p class="mt-4 leading-relaxed text-muted">{challenge}</p>
          <h2 class="mt-8 text-2xl font-semibold tracking-tight">La propuesta</h2>
          <p class="mt-3 leading-relaxed text-muted">{approach}</p>
        </div>

        {concept && (
          <ol class="grid justify-items-center rounded-2xl border border-line bg-white p-6 text-center text-sm font-bold text-muted sm:p-8" aria-label={`Flujo de ${name}`}>
            <li class="w-full max-w-64 rounded-xl border border-line bg-mist px-4 py-3">{concept[0]}</li>
            <li class="grid w-full max-w-64 gap-2 pt-2">
              <span aria-hidden="true" class="text-teal-ink">↓</span>
              <span class="rounded-xl bg-teal-ink px-4 py-3 text-white">{name}</span>
            </li>
            <li class="grid w-full max-w-64 gap-2 pt-2">
              <span aria-hidden="true" class="text-teal-ink">↓</span>
              <span class="rounded-xl border border-line bg-mist px-4 py-3">{concept[1]}</span>
            </li>
          </ol>
        )}
      </div>
    </section>

    {contribution && (
      <section class="page-container pt-16 md:pt-24" aria-labelledby="contribution-heading">
        <h2 id="contribution-heading" class="section-heading">Mi contribución</h2>
        <p class="mt-4 max-w-prose leading-relaxed text-muted">{contribution}</p>
      </section>
    )}

    <section class="page-container py-16 md:py-24" aria-labelledby="product-heading">
      <h2 id="product-heading" class="section-heading">{productHeading}</h2>
      <ProductList class="mt-8 grid gap-4 md:grid-cols-3">
        {features.map(({ title, description }, index) => (
          <li class="rounded-2xl border border-line p-6">
            {orderedFeatures && <span class="tag mb-3 inline-flex" aria-hidden="true">{index + 1}</span>}
            <h3 class="text-lg font-semibold">{title}</h3>
            <p class="mt-3 leading-relaxed text-muted">{description}</p>
          </li>
        ))}
      </ProductList>
    </section>

    {supportingSections.map(({ id, title, cards, columns }) => cards && (
      <section class="page-container pb-16 md:pb-24" aria-labelledby={id}>
        <h2 id={id} class="section-heading">{title}</h2>
        <ul class:list={['mt-8 grid gap-4', columns]}>
          {cards.map(({ title, description }) => (
            <li class="rounded-2xl border border-line p-6">
              <h3 class="text-lg font-semibold">{title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{description}</p>
            </li>
          ))}
        </ul>
      </section>
    ))}

    {nextSteps && (
      <section class="page-container pb-16 md:pb-24" aria-labelledby="next-steps-heading">
        <h2 id="next-steps-heading" class="section-heading">Próximos pasos</h2>
        <ul class="mt-8 grid gap-4 md:grid-cols-3">
          {nextSteps.map(({ title, description }) => (
            <li class="rounded-2xl border border-line p-6">
              <h3 class="text-lg font-semibold">{title}</h3>
              <p class="mt-3 leading-relaxed text-muted">{description}</p>
            </li>
          ))}
        </ul>
      </section>
    )}

    <section class="bg-mist py-16 md:py-24" aria-labelledby="stack-heading">
      <div class="page-container">
        <h2 id="stack-heading" class="section-heading">El stack de {name}</h2>
        {stackNote && <p class="mt-4 max-w-prose leading-relaxed text-muted">{stackNote}</p>}
        <dl class="mt-8 grid gap-4 sm:grid-cols-2">
          {stack.map(({ title, items, description }) => (
            <div class="rounded-2xl border border-line bg-white px-5 py-4">
              <dt class="font-heading text-sm font-semibold">{title}</dt>
              <dd>
                <ul class="mt-3 flex flex-wrap gap-2">
                  {items.map((item) => <li class="tag">{item}</li>)}
                </ul>
                {description && <p class="mt-3 text-sm leading-relaxed text-muted">{description}</p>}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </section>
  </main>

  <footer class="border-t border-line text-sm text-muted">
    <div class="page-container flex flex-wrap items-center justify-between gap-4 py-7">
      <p>© {new Date().getFullYear()} Jesús Chacón Ávila · Málaga</p>
      <a href="/#proyectos" class="font-bold text-teal-ink underline-offset-4 hover:underline">Todos los proyectos</a>
    </div>
  </footer>
</SiteLayout>
